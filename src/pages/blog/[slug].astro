---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StoreBadge from '../../components/StoreBadge.astro';
import Faq from '../../components/Faq.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE, CATEGORIES, CTA } from '../../config';
import { formatDate, readingTime } from '../../utils';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => p.data.date <= new Date());
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props as { post: CollectionEntry<'blog'>; posts: CollectionEntry<'blog'>[] };
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const url = `${SITE.url}/blog/${post.id}/`;

const related = posts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => {
    const sameA = a.data.category === post.data.category ? 1 : 0;
    const sameB = b.data.category === post.data.category ? 1 : 0;
    return sameB - sameA || b.data.date.valueOf() - a.data.date.valueOf();
  })
  .slice(0, 3);

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
    mainEntityOfPage: url,
    image: `${SITE.url}/og.png`,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/icon.png` } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
if (post.data.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: post.data.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---

<Base title={post.data.title} description={post.data.description} type="article" jsonLd={jsonLd}>
  <article data-post={post.id}>
    <header class="article-head">
      <div class="wrap narrow">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/blog/">Blog</a></nav>
        <span class="chip">{CATEGORIES[post.data.category]}</span>
        <h1>{post.data.title}</h1>
        <p class="desc">{post.data.description}</p>
        <div class="meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span>·</span>
          <span>{readingTime(post.body ?? '')} min read</span>
        </div>
      </div>
    </header>

    <div class="wrap narrow prose">
      {toc.length > 2 && (
        <nav class="toc" aria-label="Table of contents">
          <strong>In this guide</strong>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}

      <Content />

      {post.data.faq.length > 0 && (
        <>
          <h2 id="faq">Frequently asked questions</h2>
          <Faq items={post.data.faq} />
        </>
      )}

      <aside class="app-box">
        <img class="app-icon" src="/apple-touch-icon.png" alt="" width="76" height="76" loading="lazy" />
        <div>
          <h3>{CTA.postHeading}</h3>
          <p>{CTA.postText}</p>
          <StoreBadge placement="post" />
        </div>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section soft">
      <div class="wrap">
        <div class="section-head"><h2>Keep reading</h2></div>
        <div class="grid c3">{related.map((p) => <PostCard post={p} heading="h3" />)}</div>
      </div>
    </section>
  )}

  <CtaBand />
</Base>
