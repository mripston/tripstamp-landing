---
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import { SITE } from '../config';
import { LANDING_PAGES } from '../data/landing';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description = SITE.description, type = 'website', jsonLd = [], noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL('/og.png', SITE.url).href;
const isGtm = SITE.gaId.startsWith('GTM-');

// GA4 content group, so reports can split traffic by kind of page.
const path = Astro.url.pathname;
const landingSlugs = LANDING_PAGES.map((p) => `/${p.slug}/`);
const pageType =
  path === '/' ? 'home'
  : path === '/blog/' ? 'blog-index'
  : path.startsWith('/blog/') ? 'blog-post'
  : landingSlugs.includes(path) ? 'landing'
  : noindex ? 'not-found'
  : 'page';
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="apple-itunes-app" content={`app-id=${SITE.appStoreId}`} />
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} Blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {SITE.twitter && <meta name="twitter:site" content={`@${SITE.twitter}`} />}

    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}

    {SITE.gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/${isGtm ? 'gtm.js' : 'gtag/js'}?id=${SITE.gaId}`}></script>
        <script is:inline define:vars={{ gaId: SITE.gaId, isGtm, pageType }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          if (isGtm) dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          gtag('js', new Date());
          if (!isGtm) gtag('config', gaId, { content_group: pageType });

          // Custom events. Mark app_store_click as a key event in GA4.
          //   app_store_click  {placement, page_type}  any link with data-store
          //   contact_click    {placement}             any link with data-contact
          //   faq_open         {question}              a FAQ <details> opened
          //   post_read        {post}                  reader reached the end-of-post box
          function send(name, params) {
            gtag('event', name, Object.assign({ page_type: pageType, transport_type: 'beacon' }, params));
          }
          document.addEventListener('click', function (e) {
            var a = e.target.closest && e.target.closest('a[data-store], a[data-contact]');
            if (!a) return;
            if (a.dataset.store) send('app_store_click', { placement: a.dataset.store, link_url: a.href });
            else send('contact_click', { placement: a.dataset.contact });
          });
          document.addEventListener('toggle', function (e) {
            var d = e.target;
            if (d.tagName === 'DETAILS' && d.open && d.closest('.faq')) {
              var s = d.querySelector('summary');
              send('faq_open', { question: s ? s.textContent.slice(0, 100) : '' });
            }
          }, true);
          document.addEventListener('DOMContentLoaded', function () {
            var article = document.querySelector('article[data-post]');
            var box = document.querySelector('.app-box');
            if (!article || !box || !('IntersectionObserver' in window)) return;
            var io = new IntersectionObserver(function (entries) {
              if (entries[0].isIntersecting) { send('post_read', { post: article.dataset.post }); io.disconnect(); }
            });
            io.observe(box);
          });
        </script>
      </>
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
