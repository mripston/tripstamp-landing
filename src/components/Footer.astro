---
import { SITE, storeUrl } from '../config';
import { LANDING_PAGES } from '../data/landing';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/">
          <img src="/favicon.png" alt="" width="36" height="36" />
          {SITE.name}
        </a>
        <p style="margin-top:14px;max-width:300px">{SITE.footerBlurb}</p>
      </div>
      {LANDING_PAGES.length > 0 && (
        <div>
          <h4>Use it for</h4>
          <ul>
            {LANDING_PAGES.map((p) => <li><a href={`/${p.slug}/`}>{p.nav}</a></li>)}
          </ul>
        </div>
      )}
      <div>
        <h4>{SITE.name}</h4>
        <ul>
          <li><a href="/#features">Features</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/support/">Support</a></li>
          <li><a href={SITE.privacyUrl} rel="noopener">Privacy Policy</a></li>
          <li><a href={SITE.termsUrl} rel="noopener">Terms of Use</a></li>
        </ul>
      </div>
      <div>
        <h4>Get in touch</h4>
        <ul>
          <li><a href={storeUrl('footer')} data-store="footer" rel="noopener">Download on the App Store</a></li>
          <li><a href={`mailto:${SITE.email}`} data-contact="footer">Email support</a></li>
          {SITE.twitter && <li><a href={`https://x.com/${SITE.twitter}`} rel="noopener">X / Twitter</a></li>}
        </ul>
      </div>
    </div>
    <div class="legal">
      <p>© {year} <a href={SITE.companyUrl} rel="noopener">{SITE.company}</a>. All rights reserved.</p>
      {SITE.disclaimer && <p>{SITE.disclaimer}</p>}
    </div>
  </div>
</footer>
