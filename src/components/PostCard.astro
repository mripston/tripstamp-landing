---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '../config';
import { formatDate, readingTime } from '../utils';

interface Props { post: CollectionEntry<'blog'>; heading?: 'h2' | 'h3' }
const { post, heading: Heading = 'h2' } = Astro.props;
const label = CATEGORIES[post.data.category];
---

<a class="post-card" href={`/blog/${post.id}/`}>
  <span class="chip">{label}</span>
  <Heading>{post.data.title}</Heading>
  <p>{post.data.description}</p>
  <div class="meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <span>·</span>
    <span>{readingTime(post.body ?? '')} min read</span>
  </div>
</a>
